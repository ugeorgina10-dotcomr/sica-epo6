APP_NAME=SICA-EPO6
# En producción: APP_ENV=production y APP_DEBUG=false (con debug=true se muestran rutas y datos internos)
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Varias peticiones a la vez con `php artisan serve` (login, escaneos del teléfono y actualización de pantalla ya no se hacen cola)
# Más rápido: usa  php rapido.php  (o  composer rapido)  en lugar de  php artisan serve.
# Si prefieres artisan serve en Linux / Codespaces, quita el # de la siguiente línea:
# PHP_CLI_SERVER_WORKERS=4   (no funciona en Windows)

# 10 = contraseñas ~4 veces más rápidas de guardar y revisar que con 12 (sigue siendo seguro para este sistema)
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base de datos MySQL de XAMPP (se crea sola con instalar.bat)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# En Render (Postgres): DB_CONNECTION=pgsql, DB_PORT=5432 y DB_URL=<Internal Database URL>; DB_HOST/USERNAME/PASSWORD ya no hacen falta con DB_URL
DB_DATABASE=sica_epo6_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SAME_SITE=lax
# En producción con HTTPS, cambia a true (la cookie de sesión solo viaja por HTTPS)
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
